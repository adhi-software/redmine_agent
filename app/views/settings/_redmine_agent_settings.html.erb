// Initialise the jQuery-UI dialog on demand. Doing it here (rather than only on
// $(document).ready) means it still works even if another plugin's ready
// handler throws and aborts the ready chain before ours would have run.
function ensureAgentDialog() {
  var $dlg = jQuery("#agent-dlg");
  // Already initialised? jQuery-UI adds this class to the dialog content node.
  if ($dlg.hasClass("ui-dialog-content")) { return $dlg; }
  $dlg.dialog({
    autoOpen: false,
    resizable: false,
    modal: false,
    width: 440,
    dialogClass: 'agent-config-dialog',
    buttons: {
      "Ok": function () {
        var box    = agentListbox();
        var name   = (document.getElementById("agent_name").value || "").trim();
        var model  = (document.getElementById("agent_model").value || "").trim();
        var server = (document.getElementById("agent_server_url").value || "").trim();
        var key    = (document.getElementById("agent_api_key").value || "").trim();
        var editIndex = ("Edit" === agentAction) ? box.selectedIndex : -1;

        if (name === "") { alert(LBL_AGENT_NAME + " " + LBL_AGENT_INVALID); return; }
        if (model === "") { alert(LBL_AGENT_MODEL + " " + LBL_AGENT_INVALID); return; }
        if (agentNameExists(box, name, editIndex)) { alert(LBL_AGENT_DUPLICATE); return; }

        var opt;
        if ("Add" === agentAction) {
          opt = document.createElement("option");
          box.options.add(opt);
        } else {
          opt = box.options[box.selectedIndex];
        }
        opt.value = [name, model, server, key, agentConnected ? "1" : "0"].join("|");
        opt.text  = agentMaskedLabel(name, model, server, key);
        if ("Add" === agentAction) { box.selectedIndex = box.options.length - 1; }
        renderAgentList();
        jQuery(this).dialog("close");
      },
      "Cancel": function () { jQuery(this).dialog("close"); }
    }
  });
  return $dlg;
}

function showAgentDialog(action) {
  var box = agentListbox();
  var $dlg = ensureAgentDialog();
  if ("Add" === action) {
    agentAction = action;
    document.getElementById("agent_name").value = "";
    document.getElementById("agent_model").value = "";
    document.getElementById("agent_server_url").value = "";
    document.getElementById("agent_api_key").value = "";
    resetAgentTestStatus();
    setAgentConnected(false);
    $dlg.dialog("open");
  } else if ("Edit" === action && box != null && box.selectedIndex >= 0) {
    agentAction = action;
    var parts = box.options[box.selectedIndex].value.split("|");
    document.getElementById("agent_name").value       = parts[0] || "";
    document.getElementById("agent_model").value      = parts[1] || "";
    document.getElementById("agent_server_url").value = parts[2] || "";
    document.getElementById("agent_api_key").value    = parts[3] || "";
    resetAgentTestStatus();
    setAgentConnected(parts[4] === "1");
    $dlg.dialog("open");
  } else if (box != null && box.options.length > 0) {
    alert(LBL_AGENT_SELECT);
  }
}

function removeSelectedAgent() { if (agentList) { agentList.remove(); } }

(function () {
  // Editing a connection field invalidates an earlier test, so neither the
  // message nor the indicator refers to settings it wasn't run against.
  ["agent_model", "agent_server_url", "agent_api_key"].forEach(function (id) {
    var field = document.getElementById(id);
    if (field) {
      field.addEventListener("input", function () {
        resetAgentTestStatus();
        setAgentConnected(false);
      });
    }
  });

  ["mcp_url", "mcp_token"].forEach(function (id) {
    var field = document.getElementById(id);
    if (field) {
      field.addEventListener("input", function () {
        resetMcpTestStatus();
        setMcpConnected(false);
      });
    }
  });

  agentList = configList("settings_agents", "settings_agents_view",
                         function () { showAgentDialog("Edit"); });
  mcpList   = configList("settings_mcp_servers", "settings_mcp_servers_view",
                         function () { showMcpDialog("Edit"); });
})();
