<%
  # Each configured agent is stored as a pipe-encoded row:
  #   name|model|server_url|api_key|connect_model
  # where name is a free-text label (the API to call is decided by the host) and
  # connect_model is the 1/0 result of the last Test Model run. The list box
  # shows a masked label (the API key is never shown), but the option *value*
  # keeps the full row so it round-trips on save.
  agent_helper = Object.new.extend(RedmineAgentHelper)
  agents = Array(settings['agents']).reject(&:blank?)
  agent_options = agents.map do |row|
    parts      = row.to_s.split('|', 5)
    type       = parts[0].to_s
    model      = parts[1].to_s
    server_url = parts[2].to_s
    api_key    = parts[3].to_s

    label = type
    label += "  |  #{model}"      if model.present?
    label += "  |  #{server_url}" if server_url.present?
    label += "  |  ****"          if api_key.present?
    [label, row]
  end

  # MCP server rows are stored the same way: name|url|token|connected.
  mcp_rows = Array(settings['mcp_servers']).reject(&:blank?)
  mcp_options = mcp_rows.map do |row|
    parts = row.to_s.split('|', 4)
    label = parts[0].to_s
    label += "  |  #{parts[1]}" if parts[1].present?
    label += '  |  ****'        if parts[2].present?
    [label, row]
  end

  is_mcp_install = agent_helper.mcp_installed?
%>

<div class="agent-config-row" style="display:flex; align-items:flex-start; padding:3px 0;">
  <label for="settings_agents" style="flex:0 0 295px; width:295px; margin:0 5px 0 0; float:none; text-align:end; font-weight:bold; line-height:24px;"><%= l(:label_redmine_agent_llm_config) %></label>
  <div style="flex:1 1 auto; min-width:0;">
    <%= select_tag 'settings[agents]',
          options_for_select(agent_options),
          multiple: true, size: 6, id: 'settings_agents',
          class: 'multi-row', style: 'display:none;' %>
    <ul id="settings_agents_view" class="agents-sortable"></ul>
  </div>
</div>
<p>
  <%= link_to l(:button_add),    "javascript:showAgentDialog('Add');",  class: 'button' %> |
  <%= link_to l(:button_edit),   "javascript:showAgentDialog('Edit');", class: 'button' %> |
  <%= link_to l(:button_delete), "javascript:removeSelectedAgent();",   class: 'button' %>
</p>

<p>
  <label for="settings_instructions"><strong><%= l(:label_redmine_agent_instructions) %></strong></label>
  <%# The plugin default seeds this on install only; once saved, a cleared box stays blank. %>
  <%= text_area_tag 'settings[instructions]', settings['instructions'],
        id: 'settings_instructions', rows: 8,
        style: 'width:520px; max-width:100%; box-sizing:border-box;' %></br>
  <%= l(:label_redmine_agent_instructions_hint) %>
</p>

<p>
  <label for="settings_human_in_the_loop"><strong><%= l(:label_redmine_agent_hitl) %></strong></label>
  <%= hidden_field_tag 'settings[human_in_the_loop]', '0', id: nil %>
  <%= check_box_tag 'settings[human_in_the_loop]', '1',
        settings['human_in_the_loop'].to_s == '1',
        id: 'settings_human_in_the_loop' %>
  <%= l(:label_redmine_agent_hitl_hint) %>
</p>

<div class="agent-config-row" style="display:flex; align-items:flex-start; padding:3px 0;">
  <label for="settings_mcp_servers" style="flex:0 0 295px; width:295px; margin:0 5px 0 0; float:none; text-align:end; font-weight:bold; line-height:24px;"><%= l(:label_agent_mcp_servers) %></label>
  <div style="flex:1 1 auto; min-width:0;">
    <%# Posted even when every row is removed, so deleting the last one sticks. %>
    <%= hidden_field_tag 'settings[mcp_servers][]', '', id: nil %>
    <%= select_tag 'settings[mcp_servers]',
          options_for_select(mcp_options),
          multiple: true, size: 6, id: 'settings_mcp_servers',
          class: 'multi-row', style: 'display:none;' %>
    <ul id="settings_mcp_servers_view" class="agents-sortable"></ul>
  </div>
</div>
<p>
  <%= link_to l(:button_add),    "javascript:showMcpDialog('Add');",  class: 'button' %> |
  <%= link_to l(:button_edit),   "javascript:showMcpDialog('Edit');", class: 'button' %> |
  <%= link_to l(:button_delete), "javascript:removeSelectedMcp();",   class: 'button' %>
</p>

<p>
  <label for="settings_run_as_login"><strong><%= l(:label_agent_run_as_login) %></strong></label>
  <%= text_field_tag 'settings[run_as_login]', settings['run_as_login'],
        id: 'settings_run_as_login', style: 'width:200px; max-width:100%; box-sizing:border-box;' %></br>
  <%= l(:label_agent_run_as_login_hint) %>
</p>

<p>
  <label for="settings_base_url"><strong><%= l(:label_agent_base_url) %></strong></label>
  <%= text_field_tag 'settings[base_url]', settings['base_url'],
        id: 'settings_base_url', style: 'width:320px; max-width:100%; box-sizing:border-box;' %></br>
  <%= l(:label_agent_base_url_hint) %>
</p>

<p>
  <label><strong><%= l(:label_redmine_agent_mcp_status) %></strong></label>
  <% if is_mcp_install %>
    <span class="mcp-status-ok"><%= sprite_icon('checked') %></span>
    <strong><%= l(:label_installed) %></strong>
  <% else %>
    <span class="mcp-status-bad">
      <svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 6 L6 18 M6 6 L18 18"/>
      </svg>
    </span>
    <%= l(:label_not_installed) %>
  <% end %>
</p>

<style type="text/css">
  .mcp-status-ok  .icon-svg,
  .mcp-status-bad .icon-svg { width: 1.5rem; height: 1.5rem; vertical-align: middle; stroke-width: 2.5; }
  .mcp-status-ok  .icon-svg { stroke: #28a745; stroke-width: 4.5; }
  .mcp-status-bad .icon-svg { stroke: #dc3545; stroke-width: 4.5; }

  .agent-config-dialog .ui-dialog-buttonpane { text-align: right; padding: 8px 12px; }
  .agent-config-dialog .ui-dialog-buttonpane .ui-dialog-buttonset { float: none; }
  .agent-config-dialog .ui-dialog-buttonpane button {
    display: inline-block;
    vertical-align: middle;
    margin: 0 0 0 8px;
  }

  /* Looks like a native multi-select listbox; each row is drag-sortable. */
  .agents-sortable {
    list-style: none; margin: 0; padding: 0;
    width: 320px; max-width: 100%; height: 120px; overflow-y: auto;
    border: 1px solid #a9a9a9;
    box-sizing: border-box;
    font-size: 0.9em; line-height: 1.4;
  }
  .agents-sortable li { margin: 0 !important; }
  .agents-sortable .agent-item {
    display: flex; align-items: center; gap: 6px;
    padding: 1px 4px; cursor: move;
  }
  .agents-sortable .agent-text {
    flex: 1 1 auto; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .agents-sortable .agent-handle {
    flex: 0 0 auto; color: #555; cursor: grab;
    font-weight: bold; font-size: 1.1em;
  }
  .agents-sortable .agent-item.selected .agent-handle { color: #e6f0fa; }
  .agents-sortable .agent-item.selected { background: #3b93d9; color: #fff; }
  .agents-sortable .agent-item.dragging { opacity: 0.4; }
  .agents-sortable .agent-item.drop-target { border-top: 2px solid #3b93d9; }

  /* Only shown while testing and on failure — success speaks through the icon. */
  .agent-test-status { display: inline-block; margin-top: 6px; font-size: 1.1em; }
  .agent-test-status.fail    { color: #dc3545; }

  /* Connected / Not connected indicator, styled like the MCP status row. */
  .agent-conn-status { display: inline-flex; align-items: center; gap: 3px; }
  .agent-conn-status .icon-svg { width: 1.2rem; height: 1.2rem; stroke-width: 4.5; }
  .agent-conn-status.ok   .icon-svg { stroke: #28a745; }
  .agent-conn-status.fail .icon-svg { stroke: #dc3545; }
</style>

