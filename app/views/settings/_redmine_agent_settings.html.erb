<script type="text/javascript">
//<![CDATA[
var agentAction = "";
// Last Test Model verdict for the open dialog; saved as the row's 5th field.
var agentConnected = false;
var LBL_AGENT_NAME    = "<%= escape_javascript(l(:label_redmine_agent_name)) %>";
var LBL_AGENT_MODEL   = "<%= escape_javascript(l(:label_redmine_agent_model)) %>";
var LBL_AGENT_INVALID = "<%= escape_javascript(l('activerecord.errors.messages.invalid')) %>";
var LBL_AGENT_DUPLICATE     = "<%= escape_javascript(l(:label_redmine_agent_duplicate)) %>";
var LBL_AGENT_SELECT        = "<%= escape_javascript(l(:label_redmine_agent_select_row)) %>";
var LBL_AGENT_DELETE        = "<%= escape_javascript(l(:text_are_you_sure)) %>";
var LBL_AGENT_TESTING       = "<%= escape_javascript(l(:label_redmine_agent_testing)) %>";
var LBL_AGENT_TEST_FAIL     = "<%= escape_javascript(l(:label_redmine_agent_test_fail)) %>";
var LBL_AGENT_CONNECTED     = "<%= escape_javascript(l(:label_redmine_agent_connected)) %>";
var LBL_AGENT_NOT_CONNECTED = "<%= escape_javascript(l(:label_redmine_agent_not_connected)) %>";
var AGENT_TEST_URL          = "<%= escape_javascript(url_for(controller: '/redmine_agent', action: 'test_model')) %>";
var AGENT_CSRF_TOKEN        = "<%= escape_javascript(form_authenticity_token) %>";

// Last Test connection verdict for the open MCP dialog.
var mcpAction = "";
var mcpConnected = false;
var LBL_MCP_URL_FIELD = "<%= escape_javascript(l(:label_agent_mcp_server_url)) %>";
var LBL_MCP_TESTING   = "<%= escape_javascript(l(:label_agent_mcp_testing)) %>";
var LBL_MCP_TEST_FAIL = "<%= escape_javascript(l(:label_agent_mcp_test_fail)) %>";
var MCP_TEST_URL      = "<%= escape_javascript(url_for(controller: '/redmine_agent', action: 'test_mcp_server')) %>";

// Shared behaviour for the two config listboxes (LLM configs, MCP servers):
// render, select, drag-reorder, delete, and post every row back on save.
// onEdit is what a double-click on a row opens.
function configList(boxId, viewId, onEdit) {
  var box = document.getElementById(boxId);
  var ul  = document.getElementById(viewId);
  if (!box || !ul) { return null; }

  function render() {
    ul.innerHTML = "";
    for (var i = 0; i < box.options.length; i++) {
      var li = document.createElement("li");
      li.className = "agent-item" + (i === box.selectedIndex ? " selected" : "");
      li.dataset.index = i;
      li.draggable = true;

      var text = document.createElement("span");
      text.className = "agent-text";
      text.textContent = box.options[i].text;

      var handle = document.createElement("span");
      handle.className = "agent-handle";
      handle.textContent = "⇅";   // ⇅ up/down arrows — signals the row is draggable
      handle.setAttribute("aria-hidden", "true");

      li.appendChild(text);
      li.appendChild(handle);   // handle on the right
      ul.appendChild(li);
    }
  }

  function move(from, to) {
    if (from === to || isNaN(from) || isNaN(to)) { return; }
    var moving = box.options[from], target = box.options[to];
    box.insertBefore(moving, from < to ? target.nextSibling : target);
    box.selectedIndex = Array.prototype.indexOf.call(box.options, moving);
    render();
  }

  function remove() {
    if (box.selectedIndex >= 0) {
      if (confirm(LBL_AGENT_DELETE)) {
        for (var i = box.options.length - 1; i >= 0; i--) {
          if (box.options[i].selected) { box.remove(i); }
        }
        render();
      }
    } else if (box.options.length > 0) {
      alert(LBL_AGENT_SELECT);
    }
  }

  // A multi-select drops unselected options on submit, so select them all first
  // to post every row back — in list order.
  var form = box.form || box.closest("form");
  if (form) {
    form.addEventListener("submit", function () {
      for (var i = 0; i < box.options.length; i++) { box.options[i].selected = true; }
    });
  }

  var itemAt = function (e) { return e.target.closest("li.agent-item"); };

  ul.addEventListener("click", function (e) {
    var li = itemAt(e);
    if (li) { box.selectedIndex = +li.dataset.index; render(); }
  });
  ul.addEventListener("dblclick", function (e) {
    var li = itemAt(e);
    if (li) { box.selectedIndex = +li.dataset.index; onEdit(); }
  });

  // Native HTML5 drag-and-drop reordering.
  var dragFrom = null, dragLi = null;
  ul.addEventListener("dragstart", function (e) {
    var li = itemAt(e);
    if (!li) { return; }
    dragFrom = +li.dataset.index;
    dragLi = li;
    e.dataTransfer.effectAllowed = "move";
    // Required for the drag to actually start in Firefox.
    e.dataTransfer.setData("text/plain", li.dataset.index);
    setTimeout(function () { li.classList.add("dragging"); }, 0);
  });
  ul.addEventListener("dragover", function (e) {
    e.preventDefault();   // required to allow a drop
    e.dataTransfer.dropEffect = "move";
    var li = itemAt(e);
    for (var i = 0; i < ul.children.length; i++) { ul.children[i].classList.remove("drop-target"); }
    if (li && li !== dragLi) { li.classList.add("drop-target"); }
  });
  ul.addEventListener("drop", function (e) {
    e.preventDefault();
    var li = itemAt(e);
    if (li && dragFrom !== null) { move(dragFrom, +li.dataset.index); }
    dragFrom = null; dragLi = null;
  });
  ul.addEventListener("dragend", function () {
    dragFrom = null; dragLi = null;
    for (var i = 0; i < ul.children.length; i++) {
      ul.children[i].classList.remove("dragging", "drop-target");
    }
  });

  render();
  return { box: box, render: render, remove: remove };
}

var agentList = null;
var mcpList   = null;

function agentListbox() { return document.getElementById("settings_agents"); }
function mcpListbox()   { return document.getElementById("settings_mcp_servers"); }

function renderAgentList() { if (agentList) { agentList.render(); } }
function renderMcpList()   { if (mcpList)   { mcpList.render(); } }

// Clear the message under a Test button. Only the connected flag is stored,
// so the dialog reopens with the indicator set but no message text.
function resetTestStatus(statusId) {
  var st = document.getElementById(statusId);
  if (st) { st.textContent = ""; st.className = "agent-test-status"; }
}

// Green tick / red cross beside a Test button, same icons as the MCP row.
function setConnStatus(elId, connected) {
  var el = document.getElementById(elId);
  if (!el) { return; }
  var path = connected ? "M20 6 L9 17 L4 12" : "M18 6 L6 18 M6 6 L18 18";
  el.className = "agent-conn-status " + (connected ? "ok" : "fail");
  el.textContent = "";
  el.insertAdjacentHTML("beforeend",
    '<svg class="icon-svg" viewBox="0 0 24 24" fill="none" stroke-linecap="round" ' +
    'stroke-linejoin="round" aria-hidden="true"><path d="' + path + '"/></svg>');
  el.appendChild(document.createTextNode(connected ? LBL_AGENT_CONNECTED : LBL_AGENT_NOT_CONNECTED));
}

function resetAgentTestStatus() { resetTestStatus("agent-test-status"); }

function setAgentConnected(connected) {
  agentConnected = !!connected;
  setConnStatus("agent-conn-status", agentConnected);
}

function resetMcpTestStatus() { resetTestStatus("mcp-test-status"); }

function setMcpConnected(connected) {
  mcpConnected = !!connected;
  setConnStatus("mcp-conn-status", mcpConnected);
}

// Send a sample request to the configured URL/API key and show the result in
// the status message beside the button.
function testAgentModel() {
  var name   = (document.getElementById("agent_name").value || "").trim();
  var model  = (document.getElementById("agent_model").value || "").trim();
  var server = (document.getElementById("agent_server_url").value || "").trim();
  var key    = (document.getElementById("agent_api_key").value || "").trim();
  var st     = document.getElementById("agent-test-status");

  st.textContent = LBL_AGENT_TESTING;
  st.className = "agent-test-status testing";

  jQuery.ajax({
    url: AGENT_TEST_URL,
    method: "POST",
    dataType: "json",
    data: {
      name: name,
      model: model,
      server_url: server,
      api_key: key,
      authenticity_token: AGENT_CSRF_TOKEN
    }
  }).done(function (resp) {
    if (resp && resp.success) {
      resetAgentTestStatus();
      setAgentConnected(true);
    } else {
      st.textContent = (resp && resp.message) || LBL_AGENT_TEST_FAIL;
      st.className = "agent-test-status fail";
      setAgentConnected(false);
    }
  }).fail(function (xhr) {
    var msg = LBL_AGENT_TEST_FAIL;
    try { var j = JSON.parse(xhr.responseText); if (j && j.message) { msg = j.message; } } catch (e) {}
    st.textContent = msg;
    st.className = "agent-test-status fail";
    setAgentConnected(false);
  });
}

function agentMaskedLabel(n, m, s, k) {
  var label = n;
  if (m) { label += "  |  " + m; }
  if (s) { label += "  |  " + s; }
  if (k) { label += "  |  ****"; }
  return label;
}

// Duplicate check by name (first field), ignoring the row being edited.
function agentNameExists(box, name, skipIndex) {
  for (var i = 0; i < box.options.length; i++) {
    if (i === skipIndex) { continue; }
    if (box.options[i].value.split("|")[0].toLowerCase() === name.toLowerCase()) { return true; }
  }
  return false;
}

function mcpMaskedLabel(n, u, t) {
  var label = n;
  if (u) { label += "  |  " + u; }
  if (t) { label += "  |  ****"; }
  return label;
}

// Handshake the MCP server and report how many tools it exposes — a reachable
// server with no tools is still useless to the model.
function testMcpServer() {
  var name  = (document.getElementById("mcp_name").value || "").trim();
  var url   = (document.getElementById("mcp_url").value || "").trim();
  var token = (document.getElementById("mcp_token").value || "").trim();
  var st    = document.getElementById("mcp-test-status");

  st.textContent = LBL_MCP_TESTING;
  st.className = "agent-test-status testing";

  jQuery.ajax({
    url: MCP_TEST_URL,
    method: "POST",
    dataType: "json",
    data: {
      name: name,
      url: url,
      token: token,
      authenticity_token: AGENT_CSRF_TOKEN
    }
  }).done(function (resp) {
    if (resp && resp.success) {
      // Unlike the model test, the tool count is worth showing.
      st.textContent = resp.message || "";
      st.className = "agent-test-status";
      setMcpConnected(true);
    } else {
      st.textContent = (resp && resp.message) || LBL_MCP_TEST_FAIL;
      st.className = "agent-test-status fail";
      setMcpConnected(false);
    }
  }).fail(function (xhr) {
    var msg = LBL_MCP_TEST_FAIL;
    try { var j = JSON.parse(xhr.responseText); if (j && j.message) { msg = j.message; } } catch (e) {}
    st.textContent = msg;
    st.className = "agent-test-status fail";
    setMcpConnected(false);
  });
}

function ensureMcpDialog() {
  var $dlg = jQuery("#mcp-dlg");
  if ($dlg.hasClass("ui-dialog-content")) { return $dlg; }
  $dlg.dialog({
    autoOpen: false,
    resizable: false,
    modal: false,
    width: 440,
    dialogClass: 'agent-config-dialog',
    buttons: {
      "Ok": function () {
        var box   = mcpListbox();
        var name  = (document.getElementById("mcp_name").value || "").trim();
        var url   = (document.getElementById("mcp_url").value || "").trim();
        var token = (document.getElementById("mcp_token").value || "").trim();
        var editIndex = ("Edit" === mcpAction) ? box.selectedIndex : -1;

        if (name === "") { alert(LBL_AGENT_NAME + " " + LBL_AGENT_INVALID); return; }
        if (url === "") { alert(LBL_MCP_URL_FIELD + " " + LBL_AGENT_INVALID); return; }
        if (agentNameExists(box, name, editIndex)) { alert(LBL_AGENT_DUPLICATE); return; }

        var opt;
        if ("Add" === mcpAction) {
          opt = document.createElement("option");
          box.options.add(opt);
        } else {
          opt = box.options[box.selectedIndex];
        }
        opt.value = [name, url, token, mcpConnected ? "1" : "0"].join("|");
        opt.text  = mcpMaskedLabel(name, url, token);
        if ("Add" === mcpAction) { box.selectedIndex = box.options.length - 1; }
        renderMcpList();
        jQuery(this).dialog("close");
      },
      "Cancel": function () { jQuery(this).dialog("close"); }
    }
  });
  return $dlg;
}

function showMcpDialog(action) {
  var box = mcpListbox();
